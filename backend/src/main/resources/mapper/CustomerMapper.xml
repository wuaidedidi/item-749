<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.laundry.mapper.CustomerMapper">

    <resultMap id="CustomerResultMap" type="com.laundry.entity.Customer">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="phone" column="phone"/>
        <result property="address" column="address"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findById" resultMap="CustomerResultMap">
        SELECT * FROM customer WHERE id = #{id}
    </select>

    <select id="findByPhone" resultMap="CustomerResultMap">
        SELECT * FROM customer WHERE phone = #{phone}
    </select>

    <select id="findAll" resultMap="CustomerResultMap">
        SELECT * FROM customer
        <where>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%') 
                     OR phone LIKE CONCAT('%', #{keyword}, '%')
                     OR address LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
        ORDER BY created_at DESC
        LIMIT #{offset}, #{limit}
    </select>

    <select id="findAllList" resultMap="CustomerResultMap">
        SELECT * FROM customer ORDER BY name ASC
    </select>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM customer
        <where>
            <if test="keyword != null and keyword != ''">
                AND (name LIKE CONCAT('%', #{keyword}, '%') 
                     OR phone LIKE CONCAT('%', #{keyword}, '%')
                     OR address LIKE CONCAT('%', #{keyword}, '%'))
            </if>
        </where>
    </select>

    <insert id="insert" parameterType="com.laundry.entity.Customer" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO customer (name, phone, address, remark)
        VALUES (#{name}, #{phone}, #{address}, #{remark})
    </insert>

    <update id="update" parameterType="com.laundry.entity.Customer">
        UPDATE customer
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="address != null">address = #{address},</if>
            <if test="remark != null">remark = #{remark},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM customer WHERE id = #{id}
    </delete>

    <select id="existsByPhone" resultType="boolean">
        SELECT COUNT(*) > 0 FROM customer WHERE phone = #{phone}
    </select>

    <select id="existsByPhoneAndNotId" resultType="boolean">
        SELECT COUNT(*) > 0 FROM customer WHERE phone = #{phone} AND id != #{id}
    </select>

</mapper>
